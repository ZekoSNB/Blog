---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = ["travel", "philosophy", "random"];

const tagClass = (tag: string) => {
    const map: Record<string, string> = {
        travel: "tag-travel",
        philosophy: "tag-philosophy",
        random: "tag-random",
    };
    return map[tag.toLowerCase()] ?? "tag-random";
};
---

<!doctype html>
<html lang="sk">
    <head>
        <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
            .page-header {
                margin-bottom: 2em;
            }

            .page-header h1 {
                font-size: 2em;
                margin-bottom: 0.25em;
            }

            .page-header p {
                color: var(--text-muted);
                margin: 0;
                font-size: 1em;
            }

            .filter-bar {
                display: flex;
                gap: 0.5em;
                flex-wrap: wrap;
                margin-bottom: 2em;
            }

            .filter-btn {
                padding: 0.35em 0.9em;
                border-radius: 4px;
                border: 1px solid var(--border);
                background: transparent;
                color: var(--text-muted);
                font-size: 0.85em;
                font-weight: 600;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.15s ease;
                font-family: inherit;
            }

            .filter-btn:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .filter-btn.active {
                background: var(--accent);
                border-color: var(--accent);
                color: #fff;
            }

            .posts-grid {
                display: flex;
                flex-direction: column;
                gap: 1.5em;
            }

            .post-card {
                display: grid;
                grid-template-columns: 200px 1fr;
                gap: 1.5em;
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 6px;
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
            }

            .post-card:hover {
                border-color: var(--accent);
                box-shadow: var(--shadow);
                transform: translateY(-2px);
            }

            .post-card-img {
                width: 200px;
                height: 140px;
                object-fit: cover;
                border-radius: 4px 0 0 4px;
                display: block;
                flex-shrink: 0;
            }

            .post-card-img-placeholder {
                width: 200px;
                height: 140px;
                background: var(--bg-secondary);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--text-muted);
                font-size: 2em;
                flex-shrink: 0;
            }

            .post-card-body {
                padding: 1.25em 1.25em 1.25em 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 0.4em;
            }

            .post-card-tags {
                display: flex;
                gap: 0.35em;
                flex-wrap: wrap;
            }

            .post-card-title {
                margin: 0;
                font-size: 1.2em;
                font-weight: 700;
                color: var(--text);
                line-height: 1.3;
                transition: color 0.15s ease;
            }

            .post-card:hover .post-card-title {
                color: var(--accent);
            }

            .post-card-desc {
                margin: 0;
                color: var(--text-muted);
                font-size: 0.9em;
                line-height: 1.5;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .post-card-date {
                color: var(--text-muted);
                font-size: 0.82em;
                margin: 0;
            }

            .empty-state {
                text-align: center;
                color: var(--text-muted);
                padding: 3em 0;
                font-size: 0.95em;
            }

            @media (max-width: 600px) {
                .post-card {
                    grid-template-columns: 1fr;
                }

                .post-card-img,
                .post-card-img-placeholder {
                    width: 100%;
                    height: 180px;
                }

                .post-card-body {
                    padding: 1em;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <div class="page-header">
                <h1>Blog</h1>
                <p>{posts.length} {posts.length === 1 ? "príspevok" : "príspevky"}</p>
            </div>

            <div class="filter-bar">
                <button class="filter-btn active" data-filter="all">Všetko</button>
                {allTags.map((tag) => (
                    <button class={`filter-btn`} data-filter={tag}>
                        {tag.charAt(0).toUpperCase() + tag.slice(1)}
                    </button>
                ))}
            </div>

            <div class="posts-grid" id="posts-grid">
                {posts.map((post) => (
                    <a
                        href={`/blog/${post.id}/`}
                        class="post-card"
                        data-tags={JSON.stringify(post.data.tags ?? [])}
                    >
                        {post.data.heroImage ? (
                            <img
                                class="post-card-img"
                                src={post.data.heroImage.src}
                                alt={post.data.title}
                                loading="lazy"
                                decoding="async"
                            />
                        ) : (
                            <div class="post-card-img-placeholder">✍️</div>
                        )}
                        <div class="post-card-body">
                            {post.data.tags && post.data.tags.length > 0 && (
                                <div class="post-card-tags">
                                    {post.data.tags.map((tag) => (
                                        <span class={`tag ${tagClass(tag)}`}>{tag}</span>
                                    ))}
                                </div>
                            )}
                            <h2 class="post-card-title">{post.data.title}</h2>
                            <p class="post-card-desc">{post.data.description}</p>
                            <p class="post-card-date">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                        </div>
                    </a>
                ))}
            </div>

            <p class="empty-state" id="empty-state" style="display:none;">
                Žiadne príspevky v tejto kategórii. Ešte som nestihol. 😅
            </p>
        </main>
        <Footer />
    </body>
</html>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".post-card");
    const emptyState = document.getElementById("empty-state");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const filter = btn.dataset.filter ?? "all";

            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");

            let visible = 0;
            cards.forEach((card) => {
                const tags: string[] = JSON.parse(card.dataset.tags ?? "[]");
                const show = filter === "all" || tags.map((t) => t.toLowerCase()).includes(filter);
                card.style.display = show ? "" : "none";
                if (show) visible++;
            });

            if (emptyState) {
                emptyState.style.display = visible === 0 ? "" : "none";
            }
        });
    });
</script>
