---
import { Github, Instagram, Sun, Moon, Menu, X } from "lucide-astro";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
    <nav>
        <h2><a href="/">{SITE_TITLE}</a></h2>

        <div class="internal-links" id="nav-links">
            <HeaderLink href="/">Domov</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
            <HeaderLink href="/about">O mne</HeaderLink>
        </div>

        <div class="right-side">
            <div class="social-links">
                <a href="https://github.com/ZekoSNB" target="_blank" aria-label="GitHub">
                    <span class="sr-only">Príď na môj Github</span>
                    <Github size={20} />
                </a>
                <a href="https://instagram.com/_ozeko" target="_blank" aria-label="Instagram">
                    <span class="sr-only">Môj IG keby chceš stalkovať</span>
                    <Instagram size={20} />
                </a>
            </div>

            <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                <span class="icon-sun"><Sun size={18} /></span>
                <span class="icon-moon"><Moon size={18} /></span>
            </button>

            <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
                <span class="icon-menu"><Menu size={20} /></span>
                <span class="icon-close"><X size={20} /></span>
            </button>
        </div>
    </nav>
</header>

<script>
    // Theme toggle
    const themeBtn = document.getElementById("theme-toggle");
    const root = document.documentElement;

    function updateIcon() {
        const isDark = root.getAttribute("data-theme") === "dark";
        themeBtn?.setAttribute("data-dark", isDark ? "true" : "false");
    }
    updateIcon();

    themeBtn?.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        updateIcon();
    });

    // Hamburger
    const menuBtn = document.getElementById("menu-toggle");
    const navLinks = document.getElementById("nav-links");

    menuBtn?.addEventListener("click", () => {
        const open = navLinks?.classList.toggle("open");
        menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
        menuBtn.classList.toggle("open", !!open);
    });

    navLinks?.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => {
            navLinks.classList.remove("open");
            menuBtn?.setAttribute("aria-expanded", "false");
            menuBtn?.classList.remove("open");
        });
    });
</script>

<style>
    header {
        margin: 0;
        padding: 0 1.5em;
        background: var(--header-bg);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    h2 {
        margin: 0;
        font-size: 1em;
        white-space: nowrap;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
        color: var(--text);
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    h2 a:hover {
        color: var(--accent);
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
        gap: 1em;
    }

    .internal-links {
        display: flex;
        gap: 0.25em;
    }

    .internal-links a {
        padding: 0.4em 0.75em;
        color: var(--text-muted);
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.95em;
        transition: color 0.15s ease, background 0.15s ease;
        white-space: nowrap;
    }

    .internal-links a:hover {
        color: var(--text);
        background: var(--bg-secondary);
    }

    .internal-links a.active {
        color: var(--accent);
        font-weight: 600;
        background: var(--accent-subtle);
    }

    .right-side {
        display: flex;
        align-items: center;
        gap: 0.5em;
    }

    /* Social icons */
    .social-links {
        display: flex;
        align-items: center;
        gap: 0.25em;
    }

    .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4em;
        color: var(--accent);
        border-radius: 4px;
        text-decoration: none;
        transition: opacity 0.15s ease, background 0.15s ease;
    }

    .social-links a:hover {
        opacity: 0.75;
        background: var(--accent-subtle);
    }

    /* Theme toggle */
    #theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: transparent;
        color: var(--accent);
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease, border-color 0.15s ease;
        flex-shrink: 0;
    }

    #theme-toggle:hover {
        opacity: 0.75;
        background: var(--accent-subtle);
        border-color: var(--accent);
    }

    #theme-toggle .icon-moon { display: flex; }
    #theme-toggle .icon-sun  { display: none; }
    #theme-toggle[data-dark="true"] .icon-moon { display: none; }
    #theme-toggle[data-dark="true"] .icon-sun  { display: flex; }

    /* Hamburger */
    .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: transparent;
        color: var(--accent);
        cursor: pointer;
        flex-shrink: 0;
        transition: opacity 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }

    .menu-toggle:hover {
        opacity: 0.75;
        background: var(--accent-subtle);
        border-color: var(--accent);
    }

    .menu-toggle .icon-close { display: none; }
    .menu-toggle.open .icon-menu  { display: none; }
    .menu-toggle.open .icon-close { display: flex; }

    @media (max-width: 720px) {
        .social-links {
            display: none;
        }

        .menu-toggle {
            display: flex;
        }

        .internal-links {
            display: none;
            position: absolute;
            top: 60px;
            left: 0;
            right: 0;
            flex-direction: column;
            background: var(--header-bg);
            border-bottom: 1px solid var(--border);
            padding: 0.75em 1.5em 1em;
            gap: 0.25em;
            backdrop-filter: blur(8px);
        }

        .internal-links.open {
            display: flex;
        }

        .internal-links a {
            font-size: 1em;
            padding: 0.6em 0.75em;
        }
    }
</style>
