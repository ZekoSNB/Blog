---
import Instagram from "../assets/icons/instagram.svg";
import Github from "../assets/icons/github.svg";
const today = new Date();
---

<footer>
    <div class="footer-inner">
        <p class="copyright">
            &copy; {today.getFullYear()} Maroš Tomašov (Ozeko). Všetko je moje. Ver
            mi.
        </p>
        <div class="social-links">
            <a
                href="https://github.com/ZekoSNB"
                target="_blank"
                aria-label="GitHub"
            >
                <span class="sr-only">Príd na môj Github</span>
                <Github size={20} />
            </a>
            <a
                href="https://instagram.com/_ozeko"
                target="_blank"
                aria-label="Instagram"
            >
                <span class="sr-only">Môj IG keby chceš stalkovať</span>
                <Instagram size={20} />
            </a>
        </div>
    </div>
</footer>

<style>
    footer {
        border-top: 1px solid var(--border);
        background: var(--bg-secondary);
        transition:
            background 0.2s ease,
            border-color 0.2s ease;
    }

    .footer-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 2em 1.5em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        flex-wrap: wrap;
    }

    .copyright {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .social-links {
        display: flex;
        align-items: center;
        gap: 0.5em;
    }

    .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4em;
        color: var(--accent);
        border-radius: 4px;
        text-decoration: none;
        transition:
            opacity 0.15s ease,
            background 0.15s ease;
    }

    .social-links a:hover {
        opacity: 0.75;
        background: var(--accent-subtle);
    }

    @media (max-width: 600px) {
        .footer-inner {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
