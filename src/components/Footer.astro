                <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
                    <path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    ></path>
                </svg>
            </a>
            <a href="https://instagram.com/_ozeko" target="_blank" aria-label="Instagram">
                <span class="sr-only">Môj IG keby chceš stalkovať</span>
                <svg fill="currentColor" width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z"></path>
                    <path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z"></path>
                    <path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z"></path>
                </svg>
            </a>
        </div>
    </div>
</footer>

<style>
    footer {
        border-top: 1px solid var(--border);
        background: var(--bg-secondary);
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .footer-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 2em 1.5em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        flex-wrap: wrap;
    }

    .copyright {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .social-links {
        display: flex;
        align-items: center;
        gap: 0.5em;
    }

    .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4em;
        color: var(--text-muted);
        border-radius: 6px;
        text-decoration: none;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .social-links a:hover {
        color: var(--accent);
        background: var(--accent-subtle);
    }

    @media (max-width: 600px) {
        .footer-inner {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
